                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/productos/id-invalido"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400 para un ID inválido', function () { pm.response.to.have.status(400); pm.response.to.be.json; pm.expect(pm.response.json().message).to.eql('El identificador del producto no es válido.'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar modificaci?n directa del stock",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/productos/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rechaza modificar stock directamente', function () { pm.response.to.have.status(400); pm.response.to.be.json; pm.expect(pm.response.json().errors.join(' ')).to.include('stock solo puede modificarse'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar producto de prueba",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/productos/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 con el producto eliminado', function () { pm.response.to.have.status(200); pm.response.to.be.json; const body = pm.response.json(); pm.expect(body.message).to.eql('Producto eliminado correctamente.'); pm.expect(body.producto._id).to.eql(pm.collectionVariables.get('productId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar eliminación con ID inválido",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/productos/id-invalido"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400 para un ID inválido', function () { pm.response.to.have.status(400); pm.response.to.be.json; pm.expect(pm.response.json().message).to.eql('El identificador del producto no es válido.'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar eliminación de producto inexistente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/productos/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404 al eliminar por segunda vez', function () { pm.response.to.have.status(404); pm.response.to.be.json; pm.expect(pm.response.json().message).to.eql('Producto no encontrado.'); });"
                ]
              }
            }
          ]
        }
      ]
    },
