{
  "info": {
    "_postman_id": "8bcd5899-f5ef-46f7-81a2-bc54ca4bd9f4",
    "name": "STOCKFLOWAPI",
    "description": "Coleccion incremental de pruebas de STOCKFLOWAPI. Ejecutar solo contra una base de datos local o de pruebas; configure adminEmail y adminPassword en el entorno y ejecute el seed antes de empezar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar usuario de prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
                  "pm.collectionVariables.set('authEmail', `newman-${runId}@example.com`);",
                  "pm.collectionVariables.unset('token');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bloquea el registro publico', function () { pm.response.to.have.status(403); pm.response.to.be.json; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Newman\",\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{bodegueroPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Rechazar rol privilegiado en registro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tambien bloquea la elevacion de rol por registro', function () { pm.response.to.have.status(403); pm.response.to.be.json; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Newman\",\n  \"email\": \"elevation@example.com\",\n  \"password\": \"{{bodegueroPassword}}\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Iniciar sesi?n de administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin inicia sesion y obtiene JWT', function () { pm.response.to.have.status(200); pm.response.to.be.json; const body = pm.response.json(); pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.usuario.role).to.eql('admin'); pm.collectionVariables.set('adminToken', body.token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear bodeguero como administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Bodeguero Newman\",\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{bodegueroPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin crea un bodeguero sin exponer el hash', function () { pm.response.to.have.status(201); pm.response.to.be.json; const body = pm.response.json(); pm.expect(body.usuario.role).to.eql('bodeguero'); pm.expect(body.usuario.email).to.eql(pm.collectionVariables.get('authEmail')); pm.expect(body.usuario).not.to.have.property('passwordHash'); pm.collectionVariables.set('bodegueroId', body.usuario._id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión de usuario de prueba",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bodeguero inicia sesion y recibe JWT sin datos sensibles', function () { pm.response.to.have.status(200); pm.response.to.be.json; const body = pm.response.json(); pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.usuario.role).to.eql('bodeguero'); pm.expect(body.usuario).not.to.have.property('passwordHash'); pm.collectionVariables.set('bodegueroToken', body.token); pm.collectionVariables.set('bodegueroId', body.usuario._id); pm.collectionVariables.set('token', body.token); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
