    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bodegueroToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 con una lista JSON', function () { pm.response.to.have.status(200); pm.response.to.be.json; pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto de prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('productId');",
                  "pm.collectionVariables.unset('inventoryProductId');",
                  "pm.collectionVariables.unset('categoryId');",
                  "const runId = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('crudProductName', `Newman CRUD ${runId}`);",
                  "pm.collectionVariables.set('inventoryProductName', `Newman inventario ${runId}`);",
                  "pm.collectionVariables.set('categoryName', `Newman categoría ${runId}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('crea el producto con stock inicial cero', function () { pm.response.to.have.status(201); pm.response.to.be.json; const body = pm.response.json(); pm.expect(body.message).to.eql('Producto registrado correctamente.'); pm.expect(body.producto.nombre).to.eql(pm.collectionVariables.get('crudProductName')); pm.expect(body.producto.stock).to.eql(0); pm.collectionVariables.set('productId', body.producto._id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{crudProductName}}\",\n  \"precio\": 12.5,\n  \"descripcion\": \"Fixture generado por las pruebas Newman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Verificar producto en la lista",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bodegueroToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('la lista incluye el producto creado en esta ejecución', function () { pm.response.to.have.status(200); pm.response.to.be.json; const products = pm.response.json(); pm.expect(products).to.be.an('array'); pm.expect(products.some((product) => product._id === pm.collectionVariables.get('productId') && product.nombre === pm.collectionVariables.get('crudProductName'))).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar producto inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"precio\": -1,\n  \"stock\": 1.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/productos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400 con errores de validación', function () { pm.response.to.have.status(400); pm.response.to.be.json; const body = pm.response.json(); pm.expect(body.message).to.eql('Los datos del producto no son válidos.'); pm.expect(body.errors).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar stock inicial directo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto con stock ilegal\",\n  \"precio\": 2,\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/productos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rechaza stock inicial enviado por el cliente', function () { pm.response.to.have.status(400); pm.response.to.be.json; pm.expect(pm.response.json().errors.join(' ')).to.include('stock solo puede modificarse'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar producto de prueba",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 15.75\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/productos/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('actualiza datos permitidos sin alterar stock', function () { pm.response.to.have.status(200); pm.response.to.be.json; const body = pm.response.json(); pm.expect(body.producto.precio).to.eql(15.75); pm.expect(body.producto.stock).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar ID de producto inválido",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
