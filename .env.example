# Variables de entorno de STOCKFLOWAPI
# Copia este archivo como .env y completa los valores en local.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Cadena de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/stockflow

# Puerto del servidor
PORT=3000

# Secreto para firmar JWT
JWT_SECRET=<define-un-secreto-aleatorio-local>

# Tiempo de expiración del JWT
JWT_EXPIRES_IN=1h

# Credenciales del administrador inicial (solo para npm run seed:admin)
ADMIN_NAME=<nombre-del-administrador>
ADMIN_EMAIL=<correo-del-administrador>
ADMIN_PASSWORD=<contrasena-fuerte-local>
