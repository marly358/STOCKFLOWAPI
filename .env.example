# Variables de entorno de STOCKFLOWAPI
# Copia este archivo como .env y completa los valores en local.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# Este archivo .env.example SÍ se versiona, pero nunca debe contener credenciales reales.

# Cadena de conexión de MongoDB Atlas (usuario, contraseña y cluster propios, definidos solo en local)
MONGO_URI=

# Puerto en el que escucha el servidor
PORT=3000
